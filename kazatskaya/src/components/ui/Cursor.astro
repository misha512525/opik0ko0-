---
/** Курсор-«свечение» только для мыши. Над видео — «Смотреть», над CTA — «Написать». */
---

<div class="cursor" data-cursor-el aria-hidden="true">
  <div class="cursor__blob"></div>
  <span class="cursor__label" data-cursor-label></span>
</div>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 130;
    pointer-events: none;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.motion-ok) .cursor {
      display: block;
    }
  }
  .cursor__blob {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-blue-400);
    mix-blend-mode: multiply;
    opacity: 0.55;
    transition:
      transform 0.45s var(--ease-expo),
      opacity 0.3s var(--ease-out),
      background-color 0.3s;
  }
  :global(.cursor.is-hidden) .cursor__blob {
    opacity: 0;
  }
  :global(.cursor.is-label) .cursor__blob {
    transform: scale(4.8);
    opacity: 1;
    background: var(--color-blue-500);
    mix-blend-mode: normal;
  }
  :global(.cursor.is-hover) .cursor__blob {
    transform: scale(2.2);
    opacity: 0.35;
  }
  .cursor__label {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) scale(0.8);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    opacity: 0;
    white-space: nowrap;
    transition:
      opacity 0.2s,
      transform 0.45s var(--ease-expo);
  }
  :global(.cursor.is-label) .cursor__label {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
</style>
