---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'dark' | 'light';
  size?: 'md' | 'sm';
  icon?: 'arrow' | 'tg' | 'down';
  external?: boolean;
  /** Цель для аналитики */
  goal?: string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  icon = 'arrow',
  external = href.startsWith('http'),
  goal,
  class: cls,
  ...rest
} = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', cls].filter(Boolean).join(' ');
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---

<a href={href} class={classes} data-goal={goal} {...ext} {...rest}>
  <span class="btn__label"><slot /></span>
  <span class="btn__icon"><Icon name={icon} size={16} /></span>
</a>
