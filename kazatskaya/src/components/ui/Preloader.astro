---
/** Интро ≤ 1,2 с: строка тетради «пишется», появляется «АК», шторка уходит вверх. Пропускается кликом/клавишей. */
---

<div class="preloader paper-grid" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <span class="preloader__mono">
      <span data-pl-letter>А</span><span data-pl-letter>К</span>
    </span>
    <span class="preloader__line" data-pl-line></span>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: none;
    place-items: center;
    background-color: var(--color-sky-50);
    clip-path: inset(0 0 0 0);
  }
  :global(.motion-ok:not(.intro-seen)) .preloader {
    display: grid;
  }
  .preloader__inner {
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .preloader__mono {
    display: flex;
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-navy-900);
    padding-bottom: 0.06em;
  }
  .preloader__mono span {
    display: inline-block;
  }
  .preloader__mono span + span {
    font-style: italic;
    color: var(--color-blue-500);
  }
  .preloader__line {
    width: min(240px, 60vw);
    height: 1.5px;
    background: var(--color-blue-500);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
</style>
