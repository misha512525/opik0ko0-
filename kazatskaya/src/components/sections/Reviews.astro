---
import { REVIEWS, LINKS } from '@/content/content';
import { SHOW_TODO, isPlaceholder } from '@/lib/links';
import { typo } from '@/lib/typo';
import Rich from '../ui/Rich.astro';
import Icon from '../ui/Icon.astro';

// Никогда не выдумываем отзывы: карточки с плейсхолдерами видны только в режиме редактуры
const items = REVIEWS.items.filter((r) =>
  r.kind === 'screenshot' ? true : SHOW_TODO || !(isPlaceholder(r.text) || isPlaceholder(r.name)),
);
const hasItems = items.length > 0;
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container reviews__head">
    <h2 id="reviews-title" class="h2" data-reveal><Rich text={REVIEWS.title} /></h2>
    <p class="lead" data-reveal>{typo(REVIEWS.lead)}</p>
  </div>

  {
    hasItems && (
      <div class="reel" data-reel>
        <ul class="reel__track" data-reel-track>
          {items.map((r) =>
            r.kind === 'screenshot' ? (
              <li class="rv rv--shot">
                <div class="rv__phone">
                  <img src={r.src} alt={r.alt} loading="lazy" decoding="async" />
                </div>
              </li>
            ) : (
              <li
                class:list={['rv', isPlaceholder(r.text) && 'todo']}
                data-todo={isPlaceholder(r.text) ? 'реальный отзыв' : undefined}
              >
                <svg class="rv__quote" viewBox="0 0 40 32" aria-hidden="true">
                  <path d="M0 32V19C0 8 6 1 17 0l1 5C11 7 8 11 8 17h8v15H0Zm22 0V19C22 8 28 1 39 0l1 5c-7 2-10 6-10 12h8v15H22Z" />
                </svg>
                <blockquote class="rv__text">{typo(r.text)}</blockquote>
                <p class="rv__who">
                  <span class="hand">{r.name}</span>
                  {r.score && <span class="rv__score">{r.score}</span>}
                </p>
              </li>
            ),
          )}
        </ul>
        <div class="reel__progress" aria-hidden="true">
          <span data-reel-progress />
        </div>
      </div>
    )
  }

  <div class="container">
    <a class="channel" href={LINKS.results} target="_blank" rel="noopener" data-goal="reviews_channel">
      <div class="channel__text">
        <span class="channel__title">{REVIEWS.channelCta}</span>
        <span class="channel__sub">t.me/egerusskiy100Kazatskaya</span>
      </div>
      <span class="channel__btn">
        <span class="btn btn--primary">
          <span class="btn__label">Открыть канал</span>
          <span class="btn__icon"><Icon name="arrow" size={16} /></span>
        </span>
      </span>
    </a>
  </div>
</section>

<style>
  .reviews {
    padding-block: var(--section-y);
    overflow: clip;
  }
  .reviews__head {
    display: grid;
    gap: 20px;
  }

  /* ---------- Лента ---------- */
  .reel {
    margin-top: clamp(32px, 5vw, 56px);
  }
  .reel__track {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 8px var(--gutter) 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .reel__track::-webkit-scrollbar {
    display: none;
  }
  .rv {
    position: relative;
    flex: 0 0 min(82vw, 380px);
    scroll-snap-align: start;
    display: grid;
    align-content: space-between;
    gap: 20px;
    min-height: 300px;
    padding: 28px 26px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .rv__quote {
    width: 34px;
    fill: var(--color-blue-300);
  }
  .rv__text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.25;
  }
  .rv__who {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-blue-800);
  }
  .rv__score {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-pen-red);
  }
  .rv--shot {
    padding: 14px;
    background: var(--color-navy-900);
  }
  .rv__phone {
    border-radius: 22px;
    overflow: hidden;
  }
  .reel__progress {
    height: 2px;
    margin-inline: var(--gutter);
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .reel__progress span {
    display: block;
    height: 100%;
    background: var(--color-blue-500);
    transform-origin: 0 50%;
    transform: scaleX(0.15);
  }

  /* ---------- Карточка-ссылка на канал ---------- */
  .channel {
    position: relative;
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 5vw, 56px);
    padding: 28px 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background-color: #fff;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }
  .channel:hover {
    border-color: var(--color-blue-500);
  }
  .channel:active {
    transform: scale(0.99);
  }
  .channel__text {
    display: grid;
    gap: 10px;
  }
  .channel__title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 4rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .channel__sub {
    font-size: 0.875rem;
    color: var(--color-ink-500);
    overflow-wrap: anywhere;
  }
  .channel__btn {
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .reviews__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .rv {
      flex-basis: 420px;
    }
    .channel {
      grid-template-columns: 1fr auto;
      align-items: end;
      padding: 48px;
    }
  }
</style>
